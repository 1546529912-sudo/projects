.story-card {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.06);
  transition: transform 0.15s;
}

.story-card--pressed {
  transform: scale(0.975);
}

.story-card__cover {
  width: 100%;
  height: 220rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.story-card__badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(255,255,255,0.88);
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #333333;
}

.story-card__cover-img {
  width: 100%;
  height: 100%;
}

.story-card__cover-deco {
  font-size: 80rpx;
  font-weight: 900;
  color: rgba(255,255,255,0.38);
  letter-spacing: -2rpx;
}

.story-card__body {
  padding: 20rpx 22rpx 18rpx;
}

.story-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.story-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.story-card__meta {
  font-size: 22rpx;
  color: #8E8E93;
  flex: 1;
}

.story-card__arrow {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.story-card__arrow-icon {
  font-size: 36rpx;
  color: rgba(255,255,255,0.92);
  font-weight: 700;
  line-height: 1;
  margin-top: -2rpx;
}

.story-card__progress {
  height: 4rpx;
  background: #EBEBEB;
  border-radius: 2rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.story-card__progress-bar {
  height: 100%;
  border-radius: 2rpx;
  transition: width 0.3s;
}
