.mask {
  position: fixed;
  inset: 0;
  background: transparent;
  z-index: 100;
  pointer-events: none;
  transition: background 0.2s;
}

.mask--show {
  pointer-events: auto;
}

.popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 48rpx 60rpx;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.12);
  transform: translateY(100%);
  transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform;
}

.popup--show {
  transform: translateY(0);
}

.popup__header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.popup__word {
  font-size: 52rpx;
  font-weight: 700;
  color: #2D2D2D;
  letter-spacing: 1rpx;
}

.popup__phonetic {
  font-size: 28rpx;
  color: #888888;
  flex: 1;
  padding-top: 6rpx;
}

.popup__play {
  width: 72rpx;
  height: 72rpx;
  background: #FFF0E0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.popup__play-icon {
  font-size: 32rpx;
  line-height: 1;
}

@keyframes pulse {
  from { opacity: 1; transform: scale(1); }
  to   { opacity: 0.6; transform: scale(0.88); }
}

.popup__pos {
  font-size: 24rpx;
  color: #FF8C42;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.popup__def {
  font-size: 34rpx;
  color: #2D2D2D;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.popup__actions {
  display: flex;
  justify-content: flex-end;
}

.popup__save {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  transition: background 0.15s;
}

.popup__save--saved {
  background: #FFF0E0;
  color: #FF8C42;
}

.popup__save-icon {
  font-size: 28rpx;
  line-height: 1;
}
