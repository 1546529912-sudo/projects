.player {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.10);
}

.player__btn {
  width: 88rpx;
  height: 88rpx;
  background: #FF8C42;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.1s;
}

.player__btn--pressed {
  transform: scale(0.92);
}

.player__btn--playing {
  background: #FFF0E0;
}

.player__icon {
  font-size: 36rpx;
  color: #FFFFFF;
  line-height: 1;
}

.player__btn--playing .player__icon {
  color: #FF8C42;
}

.player__progress-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.player__progress-bg {
  height: 8rpx;
  background: #F0E6D8;
  border-radius: 4rpx;
  overflow: hidden;
}

.player__progress-fill {
  height: 100%;
  background: #FF8C42;
  border-radius: 4rpx;
  transition: width 0.5s linear;
}

.player__time {
  font-size: 22rpx;
  color: #AAAAAA;
}
