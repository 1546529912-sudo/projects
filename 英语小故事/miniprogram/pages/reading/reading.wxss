.reading {
  min-height: 100vh;
  background: #F4F1EC;
  display: flex;
  flex-direction: column;
}

/* 故事封面图 */
.reading__cover {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}

.reading__cover-img {
  width: 100%;
  height: 100%;
}

.reading__cover-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to bottom, transparent, #F4F1EC);
}

/* 导航栏 */
.reading__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 20rpx;
  background: #FFF8F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.reading__back,
.reading__fav {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reading__back-icon {
  font-size: 56rpx;
  color: #2D2D2D;
  font-weight: 300;
  line-height: 1;
}

.reading__fav-icon {
  font-size: 44rpx;
  color: #CCCCCC;
  line-height: 1;
}

.reading__fav-icon--active {
  color: #FF4D4D;
}

.reading__vocab-icon {
  font-size: 40rpx;
  line-height: 1;
}

/* 滚动区 */
.reading__scroll {
  flex: 1;
  padding: 0 40rpx;
}


.reading__title {
  font-size: 52rpx;
  font-weight: 800;
  color: #2D2D2D;
  margin-bottom: 48rpx;
  line-height: 1.35;
  letter-spacing: -0.5rpx;
}

/* 正文 — 关键排版 */
.reading__content {
  font-size: 44rpx;
  line-height: 2.2;
  color: #2D2D2D;
}

.reading__sentence {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 0.5em;
  padding: 6rpx 10rpx;
  border-radius: 16rpx;
  transition: background 0.3s;
}

.reading__sentence--active {
  background: rgba(91, 173, 143, 0.15);
}

.reading__word {
  display: inline;
  padding: 6rpx 8rpx;
  border-radius: 10rpx;
  cursor: pointer;
  transition: background 0.1s, color 0.1s, transform 0.1s;
  margin: 4rpx 5rpx;
  line-height: inherit;
}

.reading__word--active {
  background: #FFD4B2;
  color: #D4600A;
  transform: scale(1.08);
}

.reading__punct {
  display: inline;
  color: #2D2D2D;
  margin: 0 2rpx;
  font-size: 44rpx;
}

.reading__break {
  width: 100%;
  height: 0.8em;
}

.reading__bottom-spacer {
  height: 240rpx;
}

/* 底部工具栏 */
.reading__toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: #FFF8F0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-top: 2rpx solid #F0E6D8;
}

.reading__toolbar audio-player {
  flex: 1;
}

.reading__vocab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #888888;
  width: 88rpx;
  flex-shrink: 0;
}

.reading__vocab-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 加载遮罩 */
.reading__loading {
  position: fixed;
  inset: 0;
  background: rgba(255,248,240,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.reading__loading-dot {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #FFD4B2;
  border-top-color: #FF8C42;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
