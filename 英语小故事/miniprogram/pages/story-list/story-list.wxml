<view class="list">
  <view class="list__header" style="background: {{levelColor}}">
    <view class="list__level">L{{level}} · {{levelName}}</view>
    <view class="list__desc">{{levelDesc}}</view>
    <view class="list__count">{{stories.length}} 篇故事</view>
  </view>

  <view class="list__grid" wx:if="{{!loading}}">
    <view wx:for="{{stories}}" wx:key="_id">
      <story-card story="{{item}}" bindtap="onStoryTap" />
    </view>
    <view wx:if="{{stories.length === 0}}" class="list__empty">
      <text>故事即将上线 🌱</text>
    </view>
  </view>
</view>
