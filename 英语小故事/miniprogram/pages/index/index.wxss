.index {
  padding: 0 0 20rpx;
  min-height: 100vh;
}

/* Hero：图片容器，从顶部铺满 */
.index__hero {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
}

/* widthFix：宽度撑满，高度自适应，容器 overflow:hidden 裁掉下方 */
.index__hero-bg {
  width: 750rpx;
  display: block;
}

/* 底部渐变淡出，浮在图片上 */
.index__hero-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 260rpx;
  background: linear-gradient(to bottom, transparent, #F4F1EC);
}

/* 标题浮在图片左上角 */
.index__navbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: 16rpx;
}

.index__navbar-title {
  font-size: 48rpx;
  font-weight: 800;
  color:rgb(37, 37, 39);
  letter-spacing: -1rpx;
  text-shadow: 0 2px 16px rgba(255,255,255,0.9);
}

.index__navbar-sub {
  font-size: 32rpx;
  font-weight: 400;
  color:rgb(99, 98, 97);
  line-height: 100rpx;
  margin-left: 12rpx;
  margin-top: 24rpx;
  text-shadow: none;
}

/* 固定头部（Hero + Tabs） */
.index__header {
  position: sticky;
  top: 0;
  z-index: 20;
}

/* 等级 Tabs */
.index__levels {
  white-space: nowrap;
  margin-top: -120rpx;
  margin-bottom: 36rpx;
}

.index__levels-inner {
  display: flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.index__level-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: transform 0.15s;
}

.index__level-chip--active {
  transform: scale(1.06);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.10);
}

.index__level-chip-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.index__level-chip-label {
  font-size: 20rpx;
  color: #555555;
  margin-top: 3rpx;
  font-weight: 500;
}

/* 区块标题 */
.index__section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  padding: 0 32rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.index__section-icon {
  font-size: 28rpx;
}

/* 最近阅读 */
.index__recent {
  white-space: nowrap;
  margin-bottom: 36rpx;
}

.index__recent-inner {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
}

.index__recent-item {
  width: 340rpx;
  flex-shrink: 0;
}

/* 故事网格 */
.index__stories {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 32rpx;
}

.index__empty {
  grid-column: 1 / -1;
  text-align: center;
  color: #8E8E93;
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* 加载动画 */
.index__loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.index__loading-dots {
  display: flex;
  gap: 14rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  background: #BBDDD0;
  border-radius: 50%;
  animation: bounce 0.8s ease-in-out infinite alternate;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  to { transform: translateY(-10rpx); background: #5BAD8F; }
}

.index__bottom-space {
  height: calc(100rpx + env(safe-area-inset-bottom) + 40rpx);
}
