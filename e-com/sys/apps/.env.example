# 电商商城 v1 · 本地开发环境变量
# 复制为 .env 后使用：cp .env.example .env

# === 应用基础 ===
APP_DEBUG=true
APP_ENV=local

# === MySQL ===
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# 各子系统使用的库
SHOP_DB=shop_db
PIM_DB=pim_db
OMS_DB=oms_db
WMS_DB=wms_db

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === 跨服务地址（容器内 DNS）===
SHOP_BACKEND_URL=http://shop-backend
PIM_BACKEND_URL=http://pim-backend
OMS_BACKEND_URL=http://oms-backend
WMS_BACKEND_URL=http://wms-backend

# === 端口（宿主机映射）===
SHOP_BACKEND_PORT=8001
PIM_BACKEND_PORT=8002
OMS_BACKEND_PORT=8003
WMS_BACKEND_PORT=8004
MYSQL_PORT_HOST=3306
REDIS_PORT_HOST=6379

# === 微信支付 / 小程序（占位）===
WX_APP_ID=wx_PLACEHOLDER_APPID
WX_APP_SECRET=wx_PLACEHOLDER_SECRET
WX_MCH_ID=wx_PLACEHOLDER_MCH_ID
WX_MCH_KEY=wx_PLACEHOLDER_KEY

# === JWT ===
JWT_SECRET=dev-only-secret-please-rotate-in-production-2026

# === Trace ===
TRACE_HEADER=X-Trace-Id
