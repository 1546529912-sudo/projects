/* 全局样式 · 与 design-system.md token 对齐 */

page {
  background-color: #F7F7F7;
  color: #222222;
  font-size: 28rpx; /* 14sp */
  font-family: -apple-system, "Helvetica Neue", "PingFang SC", sans-serif;
}

/* 通用容器 */
.container {
  padding: 32rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 文字 */
.text-primary { color: #222222; }
.text-secondary { color: #717171; }
.text-disabled { color: #B0B0B0; }
.text-brand { color: #FF385C; font-weight: 600; }

/* 按钮 */
.btn-primary {
  background-color: #FF385C;
  color: #FFFFFF;
  padding: 24rpx 48rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #222222;
  border: 2rpx solid #222222;
}

/* 空态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #717171;
}

/* 加载态 */
.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #B0B0B0;
}

/* 通用工具 */
.flex { display: flex; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.row-gap-24 > view + view { margin-top: 24rpx; }
