.page-login { padding: 80rpx 48rpx; }
.header { text-align: center; margin-bottom: 64rpx; }
.brand { font-size: 56rpx; font-weight: 700; color: #FF385C; }
.subtitle { font-size: 28rpx; color: #717171; margin-top: 12rpx; }
.form-row { margin-bottom: 24rpx; }
.input { background: #F7F7F7; padding: 24rpx; border-radius: 8rpx; font-size: 32rpx; height: 88rpx; box-sizing: border-box; }
.code-row { display: flex; gap: 16rpx; align-items: center; }
.flex-1 { flex: 1; }
.btn-code { background: #FFF; border: 2rpx solid #FF385C; color: #FF385C; font-size: 26rpx; padding: 0 24rpx; height: 88rpx; line-height: 88rpx; border-radius: 8rpx; min-width: 200rpx; }
.btn-code[disabled] { color: #B0B0B0; border-color: #DDD; }
.btn-block { width: 100%; margin-top: 32rpx; }
.tip { color: #B0B0B0; font-size: 24rpx; text-align: center; margin-top: 24rpx; }
