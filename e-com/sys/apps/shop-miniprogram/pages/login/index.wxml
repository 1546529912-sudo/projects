<view class="page-login">
  <view class="header">
    <view class="brand">电商商城</view>
    <view class="subtitle">手机号 + 验证码登录</view>
  </view>

  <view class="form card">
    <view class="form-row">
      <input class="input" type="number" maxlength="11" placeholder="手机号" value="{{phone}}" bindinput="onInputPhone" />
    </view>
    <view class="form-row code-row">
      <input class="input flex-1" type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onInputCode" />
      <button class="btn-code" disabled="{{countdown > 0}}" bindtap="onSendCode">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>
    <button class="btn-primary btn-block" bindtap="onLogin">登录</button>
    <view class="tip">dev 模式：验证码固定 123456，发送后会提示明文</view>
  </view>
</view>
