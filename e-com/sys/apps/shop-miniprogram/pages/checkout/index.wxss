.page-checkout { padding: 16rpx; padding-bottom: 160rpx; }
.address .name-phone { font-size: 30rpx; font-weight: 600; }
.address .phone { color: #717171; margin-left: 16rpx; font-weight: 400; }
.address .detail { color: #555; margin-top: 8rpx; }
.address .tip { color: #B0B0B0; font-size: 22rpx; margin-top: 8rpx; }
.empty-addr { color: #FF385C; text-align: center; padding: 32rpx; }
.section-title { font-weight: 600; margin-bottom: 16rpx; }
.row { display: flex; gap: 16rpx; padding: 12rpx 0; }
.thumb { width: 100rpx; height: 100rpx; background: #F7F7F7; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #717171; padding: 8rpx; text-align: center; flex-shrink: 0; }
.meta { flex: 1; }
.name { font-size: 28rpx; }
.attrs { color: #B0B0B0; font-size: 22rpx; margin-top: 8rpx; }
.price { color: #FF385C; font-weight: 700; }
.sums .sum-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.sums .total { border-top: 2rpx solid #F7F7F7; margin-top: 16rpx; padding-top: 24rpx; font-weight: 600; }
.input { background: #F7F7F7; padding: 16rpx; border-radius: 8rpx; min-height: 64rpx; box-sizing: border-box; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #FFF; padding: 16rpx; display: flex; align-items: center; gap: 16rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.05); }
.bar-total { flex: 1; font-size: 28rpx; }
.submit { padding: 0 56rpx; height: 80rpx; line-height: 80rpx; }
.coupon-pick { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; }
.coupon-pick-right { display: flex; align-items: center; gap: 8rpx; }
.coupon-applied { color: #FF385C; font-size: 26rpx; }
.coupon-empty { color: #999; font-size: 26rpx; }
.arrow { color: #B0B0B0; font-size: 32rpx; }
.sums .discount { color: #FF385C; }
