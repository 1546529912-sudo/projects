.page-home {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #DDDDDD;
}
.logo {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF385C;
  margin-right: 24rpx;
}
.search-box {
  flex: 1;
  background: #F7F7F7;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  color: #B0B0B0;
}
.cart-icon {
  position: relative;
  font-size: 40rpx;
  margin-left: 24rpx;
}
.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #FF385C;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 16rpx;
  line-height: 1.2;
}

/* Banner */
.banner {
  margin: 32rpx;
}
.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF385C;
}
.banner-sub {
  font-size: 24rpx;
  color: #717171;
  margin-top: 8rpx;
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 32rpx;
}
.product-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding-bottom: 16rpx;
}
.product-img-placeholder {
  width: 100%;
  aspect-ratio: 4/5;
  background: #F7F7F7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  color: #B0B0B0;
  font-size: 24rpx;
  padding: 0 16rpx;
  text-align: center;
}
.product-name {
  font-size: 28rpx;
  color: #222222;
  margin: 16rpx 16rpx 8rpx;
  font-weight: 500;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.product-price {
  font-size: 32rpx;
  color: #FF385C;
  font-weight: 600;
  margin: 0 16rpx;
}
.product-sales {
  font-size: 22rpx;
  color: #717171;
  margin: 8rpx 16rpx 0;
}

/* 错误态 */
.error {
  text-align: center;
  padding: 80rpx 32rpx;
}
.error-text {
  color: #C13515;
  margin-bottom: 32rpx;
}

/* 来源标签 */
.source-tag {
  text-align: center;
  color: #B0B0B0;
  font-size: 22rpx;
  margin-top: 32rpx;
}

/* iter-40 BIZ-09-1 Banner 轮播 + 推荐位 */
.banner-swiper { width: 100%; height: 320rpx; margin: 16rpx 24rpx 24rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; display: block; }
.featured { margin: 0 24rpx 24rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; }
.featured-title { font-weight: 600; font-size: 30rpx; color: #222; margin-bottom: 16rpx; }
.featured-scroll { white-space: nowrap; }
.featured-item { display: inline-block; width: 200rpx; margin-right: 16rpx; vertical-align: top; }
.featured-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: #f5f5f5; }
.featured-name { font-size: 24rpx; color: #222; margin-top: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.featured-price { color: #FF385C; font-weight: 600; font-size: 26rpx; margin-top: 4rpx; }

/* iter-41 BIZ-09-2 专题入口 */
.topics-block { margin: 0 24rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.topic-card { background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.topic-banner { width: 100%; height: 240rpx; display: block; background: #f5f5f5; }
.topic-info { padding: 20rpx; }
.topic-name { font-size: 30rpx; font-weight: 600; color: #222; }
.topic-desc { font-size: 24rpx; color: #717171; margin-top: 6rpx; }
.topic-time { font-size: 22rpx; color: #FF385C; margin-top: 8rpx; font-weight: 600; }
