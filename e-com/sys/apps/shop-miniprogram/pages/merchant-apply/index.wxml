<view class="page">
  <view wx:if="{{!submitted}}">
    <view class="hero">
      <text class="title">商家入驻</text>
      <text class="desc">填写以下信息提交，平台 1-3 个工作日内审核</text>
    </view>
    <view class="form">
      <view class="field">
        <text class="label">店铺 code *</text>
        <input class="input" placeholder="小写字母开头，3-30 位（如 happy-shop）" data-k="code" value="{{code}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">店铺名 *</text>
        <input class="input" placeholder="如：开心小铺" data-k="name" value="{{name}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">店铺简介</text>
        <textarea class="textarea" placeholder="主营商品 / 经营理念" data-k="description" value="{{description}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">联系人 *</text>
        <input class="input" placeholder="姓名" data-k="contact_name" value="{{contact_name}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">联系手机 *</text>
        <input class="input" type="number" maxlength="11" placeholder="11 位手机号" data-k="contact_phone" value="{{contact_phone}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">营业执照号 *</text>
        <input class="input" placeholder="统一社会信用代码 18 位" data-k="business_license" value="{{business_license}}" bindinput="onInput" />
      </view>
      <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmit">提交申请</button>
    </view>
  </view>
  <view wx:else class="done">
    <text class="ok">✅ 申请已提交</text>
    <text class="hint">平台将在 1-3 个工作日内审核，结果通过电话/短信告知</text>
    <text class="hint">审核通过后会自动建店主账号，可登录后台管理</text>
  </view>
</view>
