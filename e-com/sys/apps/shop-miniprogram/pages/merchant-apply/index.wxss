.page { padding: 32rpx 24rpx; min-height: 100vh; background: #F7F7F7; }
.hero { padding: 32rpx 0 16rpx; }
.title { font-size: 40rpx; font-weight: 600; color: #222; display: block; }
.desc { font-size: 26rpx; color: #717171; display: block; margin-top: 8rpx; }
.form { background: #fff; padding: 24rpx; border-radius: 12rpx; }
.field { margin-bottom: 24rpx; }
.label { font-size: 26rpx; color: #222; display: block; margin-bottom: 8rpx; }
.input { padding: 16rpx 20rpx; background: #F7F7F7; border-radius: 8rpx; font-size: 28rpx; }
.textarea { padding: 16rpx 20rpx; background: #F7F7F7; border-radius: 8rpx; font-size: 28rpx; height: 140rpx; width: 100%; box-sizing: border-box; }
.btn-primary { margin-top: 24rpx; background: #FF385C; color: #fff; border-radius: 12rpx; font-size: 32rpx; padding: 16rpx 0; }
.done { padding: 80rpx 32rpx; text-align: center; }
.ok { font-size: 48rpx; color: #07C160; display: block; margin-bottom: 24rpx; }
.hint { display: block; color: #717171; font-size: 26rpx; line-height: 1.8; }
