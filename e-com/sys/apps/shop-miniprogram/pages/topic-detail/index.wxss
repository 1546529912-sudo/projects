.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 40rpx; }
.loading, .error, .empty { text-align: center; color: #999; padding: 120rpx 0; }
.error { color: #F56C6C; }
.banner { width: 100%; height: 400rpx; display: block; }
.card { background: #FFFFFF; margin: 16rpx 24rpx; border-radius: 16rpx; padding: 24rpx; }
.head .title { font-size: 36rpx; font-weight: 700; color: #222; margin-bottom: 12rpx; }
.head .desc { color: #555; font-size: 26rpx; line-height: 1.5; margin-bottom: 16rpx; }
.head .time { color: #FF385C; font-size: 24rpx; font-weight: 600; }
.items { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 16rpx; }
.item { width: calc(50% - 24rpx); margin: 0; padding: 0; overflow: hidden; }
.item-img { width: 100%; height: 320rpx; display: block; background: #f5f5f5; }
.item-body { padding: 16rpx; }
.item-name { font-size: 26rpx; color: #222; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.item-price { font-size: 30rpx; color: #FF385C; font-weight: 700; margin-top: 8rpx; }
