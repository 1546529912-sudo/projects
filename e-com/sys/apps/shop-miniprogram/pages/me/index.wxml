<view class="page-me">
  <view class="header card">
    <block wx:if="{{isLogin}}">
      <view class="avatar">{{user.nickname || '用户'}}</view>
      <view class="info">
        <view class="nick">{{user.nickname}}</view>
        <view class="phone">{{user.phone}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="avatar">未登录</view>
      <view class="info">
        <button class="btn-primary" bindtap="onLogin">立即登录</button>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="section-title">我的订单</view>
    <view class="order-tabs">
      <view class="tab" bindtap="onOrdersPending">待支付</view>
      <view class="tab" bindtap="onOrders">全部订单</view>
      <view class="tab" bindtap="onRefunds">我的退款</view>
      <view class="tab" bindtap="onExchanges">我的换货</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">营销</view>
    <view class="order-tabs">
      <view class="tab" bindtap="onCouponCenter">领券中心</view>
      <view class="tab" bindtap="onMyCoupons">我的优惠券</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">个人中心</view>
    <view class="order-tabs">
      <view class="tab" bindtap="onAddresses">地址簿</view>
      <view class="tab" bindtap="onFavorites">我的收藏</view>
      <view class="tab" bindtap="onMyReviews">我的评价</view>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="card logout" bindtap="onLogout">退出登录</view>
</view>
