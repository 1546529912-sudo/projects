.page-addr-edit { padding: 24rpx; padding-bottom: 160rpx; }
.card { background: #FFFFFF; border-radius: 12rpx; padding: 24rpx; }
.row { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid #EEEEEE; }
.row:last-child { border-bottom: 0; }
.label { width: 160rpx; flex-shrink: 0; color: #717171; font-size: 26rpx; line-height: 64rpx; }
.ipt { flex: 1; min-height: 64rpx; font-size: 28rpx; line-height: 1.5; padding-top: 12rpx; }
.placeholder { color: #B0B0B0; }
.textarea { padding-top: 12rpx; min-height: 120rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #FFF; padding: 16rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.05); }
.btn-primary { background: #FF385C; color: #FFF; border-radius: 8rpx; }
