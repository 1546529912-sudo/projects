<view class="page-addr-edit">
  <view class="card">
    <view class="row">
      <text class="label">收货人</text>
      <input class="ipt" placeholder="姓名" value="{{name}}" bindinput="onName" />
    </view>
    <view class="row">
      <text class="label">手机号</text>
      <input class="ipt" placeholder="11 位手机号" maxlength="11" type="number" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="row">
      <text class="label">所在地区</text>
      <picker class="ipt picker" mode="region" value="{{region}}" bindchange="onRegion">
        <view wx:if="{{region[0]}}">{{region[0]}} {{region[1]}} {{region[2]}}</view>
        <view wx:else class="placeholder">点击选择省/市/区</view>
      </picker>
    </view>
    <view class="row">
      <text class="label">详细地址</text>
      <textarea class="ipt textarea" placeholder="街道门牌号" value="{{detail}}" bindinput="onDetail" />
    </view>
  </view>

  <view style="height: 140rpx;"></view>
  <view class="bottom-bar">
    <button class="btn-primary" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '提交中…' : '保存'}}</button>
  </view>
</view>
