.page-result { padding: 120rpx 48rpx; text-align: center; }
.icon-box { margin-bottom: 32rpx; }
.icon-ok, .icon-fail { width: 160rpx; height: 160rpx; line-height: 152rpx; border-radius: 80rpx; color: #FFF; font-size: 88rpx; margin: 0 auto; }
.icon-ok { background: #07c160; }
.icon-fail { background: #FF385C; }
.title { font-size: 40rpx; font-weight: 600; }
.msg { color: #FF385C; margin-top: 16rpx; }
.order-no { color: #B0B0B0; font-size: 24rpx; margin-top: 16rpx; }
.btns { margin-top: 80rpx; }
.btn-block { width: 100%; margin-bottom: 24rpx; }
.link { color: #717171; padding: 24rpx; }
