<view class="page-order-list">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无订单</view>

  <view wx:else>
    <view wx:for="{{list}}" wx:key="id" class="card order" bindtap="onTapOrder" data-no="{{item.order_no}}">
      <view class="head">
        <view class="no">订单号 {{item.order_no}}</view>
        <view class="status">{{item.statusText}}</view>
      </view>
      <view class="row">
        <view>共 {{item.statusText}} ¥{{item.totalYuan}}</view>
      </view>
      <view wx:if="{{item.status === 'pending_pay'}}" class="actions" catchtap="onPay" data-no="{{item.order_no}}">
        <button class="btn-primary small">去支付</button>
      </view>
    </view>
  </view>
</view>
