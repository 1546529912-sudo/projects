.page-list {
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #DDDDDD;
}
.tab {
  padding: 24rpx 16rpx;
  margin-right: 32rpx;
  color: #717171;
  font-size: 28rpx;
}
.tab-active {
  color: #222222;
  font-weight: 600;
  border-bottom: 4rpx solid #FF385C;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 32rpx;
}
.product-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding-bottom: 16rpx;
}
.product-img-placeholder {
  width: 100%;
  aspect-ratio: 4/5;
  background: #F7F7F7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  color: #B0B0B0;
  font-size: 24rpx;
  padding: 0 16rpx;
  text-align: center;
}
.product-name {
  font-size: 28rpx;
  margin: 16rpx 16rpx 8rpx;
}
.product-price {
  color: #FF385C;
  font-weight: 600;
  margin: 0 16rpx;
}
