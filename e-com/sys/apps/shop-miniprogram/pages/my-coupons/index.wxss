.page-my-coupons { padding: 0 24rpx 24rpx; }
.tabs {
  display: flex;
  background: #FFFFFF;
  margin: 0 -24rpx 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #717171;
  font-size: 28rpx;
}
.tab.active { color: #FF385C; font-weight: bold; border-bottom: 4rpx solid #FF385C; }
.select-bar {
  display: flex; justify-content: space-between; align-items: center;
  background: #FFF2F4; border-radius: 8rpx;
  padding: 20rpx 24rpx; margin-bottom: 16rpx; font-size: 26rpx;
}
.unpick { color: #FF385C; }
.empty { text-align: center; color: #999; padding: 200rpx 0; }
.link { color: #FF385C; }

.coupon-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.coupon-card.disabled { opacity: 0.45; }

.left {
  width: 200rpx;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  border-right: 1rpx dashed #DDDDDD; padding-right: 16rpx;
}
.amount { color: #FF385C; font-size: 28rpx; }
.amount .big { font-size: 56rpx; font-weight: bold; }
.min { color: #999; font-size: 22rpx; margin-top: 8rpx; }
.mid {
  flex: 1; padding: 0 24rpx;
  display: flex; flex-direction: column; justify-content: center;
}
.name { font-size: 30rpx; font-weight: bold; margin-bottom: 8rpx; }
.desc { color: #717171; font-size: 24rpx; }
.period { color: #999; font-size: 22rpx; margin-top: 8rpx; }
.order { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.right { width: 100rpx; display: flex; align-items: center; justify-content: center; }
.status.pick { color: #FF385C; font-size: 26rpx; font-weight: bold; }
