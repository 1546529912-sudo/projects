.page-review { padding: 24rpx; padding-bottom: 160rpx; }
.card { background: #FFFFFF; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.section-title { font-weight: bold; margin-bottom: 16rpx; font-size: 28rpx; }
.rating-row slider { margin-bottom: 8rpx; }
.stars { text-align: center; }
.star { font-size: 48rpx; color: #DDDDDD; margin: 0 4rpx; }
.star.on { color: #FFB400; }

.content { width: 100%; min-height: 200rpx; background: #F7F7F7; border-radius: 8rpx; padding: 16rpx; box-sizing: border-box; font-size: 28rpx; }
.count { text-align: right; color: #999; font-size: 22rpx; margin-top: 8rpx; }

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-cell { width: 160rpx; height: 160rpx; background: #F7F7F7; border-radius: 8rpx; position: relative; }
.img { width: 100%; height: 100%; border-radius: 8rpx; }
.img-remove { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.6); color: #FFF; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 28rpx; }
.img-cell.add { display: flex; align-items: center; justify-content: center; border: 2rpx dashed #DDDDDD; }
.plus { font-size: 64rpx; color: #B0B0B0; }

.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #FFF; padding: 16rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.05); }
.btn-primary { background: #FF385C; color: #FFF; border-radius: 8rpx; }
