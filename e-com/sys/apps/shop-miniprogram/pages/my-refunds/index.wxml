<view class="page-mr">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无退款记录</view>
  <block wx:else>
    <view wx:for="{{list}}" wx:key="refund_no" class="card">
      <view class="head">
        <view class="no">{{item.refund_no}}</view>
        <view class="status">{{item.statusText}}</view>
      </view>
      <view class="row"><text class="lbl">原订单</text><text>{{item.order_no}}</text></view>
      <view class="row"><text class="lbl">类型</text><text>{{item.type === 'refund_only' ? '仅退款' : '退货退款'}}</text></view>
      <view class="row"><text class="lbl">金额</text><text class="price">¥{{item.amountYuan}}</text></view>
      <view class="row"><text class="lbl">原因</text><text>{{item.reason}}</text></view>
      <view wx:if="{{item.evidenceList.length > 0}}" class="evid-row">
        <image wx:for="{{item.evidenceList}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" class="evid-thumb" />
      </view>
      <view class="row"><text class="lbl">申请时间</text><text>{{item.created_at}}</text></view>
      <view wx:if="{{item.reject_reason}}" class="row"><text class="lbl">拒绝原因</text><text>{{item.reject_reason}}</text></view>
    </view>
  </block>
</view>
