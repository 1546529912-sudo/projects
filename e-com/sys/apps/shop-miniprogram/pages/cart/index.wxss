.page-cart { padding: 16rpx; padding-bottom: 160rpx; }
.row { display: flex; gap: 16rpx; align-items: center; }
.check { width: 48rpx; height: 48rpx; border: 2rpx solid #DDD; border-radius: 24rpx; text-align: center; line-height: 44rpx; color: #FFF; flex-shrink: 0; }
.check.on { background: #FF385C; border-color: #FF385C; }
.thumb { width: 140rpx; height: 140rpx; background: #F7F7F7; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; color: #717171; font-size: 22rpx; padding: 8rpx; text-align: center; flex-shrink: 0; }
.meta { flex: 1; min-width: 0; }
.name { font-size: 28rpx; }
.attrs { color: #B0B0B0; font-size: 22rpx; margin-top: 8rpx; }
.price-line { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.price { color: #FF385C; font-weight: 700; font-size: 30rpx; }
.qty-row { display: flex; align-items: center; gap: 12rpx; }
.qty-btn { width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center; border: 2rpx solid #DDD; border-radius: 4rpx; }
.qty-num { min-width: 48rpx; text-align: center; }
.invalid { color: #FF385C; font-size: 22rpx; margin-top: 8rpx; }
.del { color: #717171; font-size: 24rpx; padding: 8rpx; flex-shrink: 0; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #FFF; padding: 16rpx; display: flex; align-items: center; gap: 16rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.05); }
.sum { flex: 1; font-size: 28rpx; }
.checkout { padding: 0 48rpx; height: 80rpx; line-height: 80rpx; }
