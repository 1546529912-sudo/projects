.page-addr-list { padding: 24rpx; padding-bottom: 160rpx; }
.select-bar { background: #FFF2F4; color: #FF385C; text-align: center; padding: 16rpx; border-radius: 8rpx; margin-bottom: 16rpx; font-size: 26rpx; }
.empty { text-align: center; color: #999; padding: 200rpx 0; }

.addr-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.row1 { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.name { font-size: 30rpx; font-weight: bold; }
.phone { color: #717171; font-size: 26rpx; }
.badge-default { background: #FF385C; color: #FFFFFF; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 16rpx; margin-left: auto; }
.row2 { color: #555; font-size: 26rpx; line-height: 1.5; }
.actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #EEEEEE; }
.action { color: #717171; font-size: 26rpx; }
.action.danger { color: #FF385C; }

.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #FFF; padding: 16rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.05); }
.btn-primary { background: #FF385C; color: #FFF; border-radius: 8rpx; }
