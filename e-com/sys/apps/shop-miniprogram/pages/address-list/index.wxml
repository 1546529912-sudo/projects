<view class="page-addr-list">
  <view wx:if="{{selectMode}}" class="select-bar">选择收货地址</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">
    暂无地址，点底部按钮添加第一条
  </view>

  <view
    wx:for="{{list}}" wx:key="id"
    class="addr-card"
    data-id="{{item.id}}"
    bindtap="onPick"
  >
    <view class="row1">
      <text class="name">{{item.name}}</text>
      <text class="phone">{{item.phone}}</text>
      <text wx:if="{{item.is_default}}" class="badge-default">默认</text>
    </view>
    <view class="row2">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</view>
    <view class="actions" wx:if="{{!selectMode}}">
      <view wx:if="{{!item.is_default}}" class="action" data-id="{{item.id}}" catchtap="onSetDefault">设为默认</view>
      <view class="action" data-id="{{item.id}}" catchtap="onEdit">编辑</view>
      <view class="action danger" data-id="{{item.id}}" catchtap="onDelete">删除</view>
    </view>
  </view>

  <view style="height: 140rpx;"></view>

  <view class="bottom-bar">
    <button class="btn-primary" bindtap="onAdd">新增地址</button>
  </view>
</view>
