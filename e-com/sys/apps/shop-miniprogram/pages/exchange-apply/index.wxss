.page { padding: 24rpx; background: #F7F7F7; min-height: 100vh; }
.hint { color: #717171; font-size: 24rpx; margin-bottom: 16rpx; }
.order-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.row { display: flex; padding: 8rpx 0; font-size: 28rpx; }
.lbl { color: #717171; width: 120rpx; }
.block { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.block-title { font-weight: 600; margin-bottom: 16rpx; }
.item { padding: 16rpx 0; border-top: 1rpx solid #eee; }
.item:first-child { border-top: 0; }
.item-head { display: flex; align-items: center; }
.check { width: 36rpx; height: 36rpx; border: 2rpx solid #DDD; border-radius: 50%; margin-right: 16rpx; }
.check.on { background: #FF385C; border-color: #FF385C; }
.item-body { flex: 1; }
.item-name { font-size: 28rpx; color: #222; }
.item-meta { font-size: 24rpx; color: #717171; margin-top: 4rpx; }
.item-form { margin-top: 16rpx; padding-left: 52rpx; }
.form-row { display: flex; align-items: center; margin-top: 8rpx; }
.lbl-sm { color: #717171; font-size: 26rpx; width: 140rpx; }
.qty { width: 100rpx; border: 1rpx solid #DDD; border-radius: 8rpx; padding: 8rpx 12rpx; text-align: center; }
.new-sku { flex: 1; border: 1rpx solid #DDD; border-radius: 8rpx; padding: 8rpx 12rpx; }
.hint-sm { color: #999; font-size: 24rpx; margin-left: 8rpx; }
.reason { width: 100%; min-height: 160rpx; border: 1rpx solid #DDD; border-radius: 8rpx; padding: 16rpx; box-sizing: border-box; font-size: 28rpx; }
.evid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.evid-item, .evid-add { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.evid-item { position: relative; overflow: hidden; }
.evid-item image { width: 100%; height: 100%; }
.evid-item .del { position: absolute; top: 4rpx; right: 4rpx; width: 36rpx; height: 36rpx; line-height: 32rpx; background: rgba(0,0,0,.5); color: #fff; border-radius: 50%; text-align: center; }
.evid-add { background: #F2F2F2; display: flex; align-items: center; justify-content: center; color: #999; font-size: 56rpx; }
.submit { background: #FF385C; color: #fff; border-radius: 999rpx; margin-top: 32rpx; }
