.page-od { padding: 0 16rpx 32rpx; }
.status-bar { background: #FF385C; color: #FFF; padding: 32rpx; }
.status-bar .t { font-size: 36rpx; font-weight: 600; }
.status-bar .n { opacity: .85; margin-top: 8rpx; font-size: 24rpx; }
.section-title { font-weight: 600; margin-bottom: 16rpx; }
.name-phone { font-size: 28rpx; }
.phone { color: #717171; margin-left: 16rpx; }
.detail { color: #555; margin-top: 8rpx; }
.row { display: flex; gap: 16rpx; padding: 12rpx 0; align-items: center; }
.thumb { width: 100rpx; height: 100rpx; background: #F7F7F7; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #717171; padding: 8rpx; text-align: center; flex-shrink: 0; }
.meta { flex: 1; }
.name { font-size: 28rpx; }
.attrs { color: #B0B0B0; font-size: 22rpx; margin-top: 8rpx; }
.sub { color: #FF385C; font-weight: 700; }
.sums .sum-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.sums .total { border-top: 2rpx solid #F7F7F7; margin-top: 16rpx; padding-top: 24rpx; font-weight: 600; }
.price { color: #FF385C; font-weight: 700; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #FFF; padding: 16rpx; display: flex; gap: 16rpx; justify-content: flex-end; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.05); }
.bottom-bar button { padding: 0 48rpx; height: 80rpx; line-height: 80rpx; font-size: 28rpx; border-radius: 8rpx; }
.review-link { color: #FF385C; font-size: 24rpx; margin-top: 8rpx; }
