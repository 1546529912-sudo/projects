{
    "name": "ecom/pim-backend",
    "description": "PIM 商品信息管理后端",
    "type": "project",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-queue": "^3.0",
        "topthink/think-migration": "^3.0",
        "ezyang/htmlpurifier": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "App\\Pim\\": "app"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "think": {
            "services": []
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
