APP_NAME="ZhongyanCompositePlatform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Shanghai

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zhongyan_platform
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# AI 微服务地址（FastAPI）
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=30

# pgvector (独立 Postgres 实例)
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=zhongyan_kb
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=

# 阿里云
ALIYUN_ACCESS_KEY=
ALIYUN_SECRET_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-shenzhen
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE_REGISTER=

# 微信支付（v3）
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_PATH=

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 快递鸟
KDNIAO_APP_ID=
KDNIAO_APP_KEY=

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173
