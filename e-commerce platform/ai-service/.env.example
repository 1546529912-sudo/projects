# =================================================================
# AI Service · 环境变量模板
# 复制本文件为 .env 后填入真实值；启动时用：
#   uvicorn app.main:app --port 8001 --env-file .env
# =================================================================

# ---------- LLM Provider 选择 ----------
# 可选值：mock | deepseek | dashscope
#   mock      = 不调真实模型（默认，用于本地开发）
#   deepseek  = DeepSeek 官方 API（https://platform.deepseek.com）
#   dashscope = 阿里通义千问（https://dashscope.aliyun.com）
LLM_PROVIDER=mock

# ---------- DeepSeek 配置（LLM_PROVIDER=deepseek 时启用）----------
# 1) 到 https://platform.deepseek.com 注册账号
# 2) 控制台 → API Keys → 创建一个 key（sk- 开头）
# 3) 把 key 填到下面这一行
LLM_API_KEY=
# 可选模型：deepseek-chat (V3) / deepseek-reasoner (R1) / 其他最新型号
LLM_MODEL=deepseek-chat
# DeepSeek API 域名（一般不用改）
LLM_BASE_URL=https://api.deepseek.com

# ---------- 通义千问配置（LLM_PROVIDER=dashscope 时启用，二选一）----------
# 1) 到 https://dashscope.console.aliyun.com 开通通义千问
# 2) 创建 API key
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

# ---------- Catalog DB（AI 服务读 SKU 的数据库路径）----------
# 默认指向项目内 backend-laravel/database/database.sqlite
# 生产环境可以改为 MySQL read-only 凭证
CATALOG_DB_PATH=
