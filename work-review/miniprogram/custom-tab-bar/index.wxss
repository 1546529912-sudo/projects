.tb {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1px solid #F0E8DE;
  padding: 0 8rpx 8rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 20;
}

/* ── 通用 tab 项 ── */
.ti {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  padding-bottom: 4rpx;
  cursor: pointer;
}

/* 图标容器：未选中态 */
.ti-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图标容器：选中态 — 凸起圆形按钮 */
.ti-btn-act {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #D4885E, #A85530);
  margin-top: -44rpx;
  box-shadow: 0 8rpx 28rpx rgba(180, 90, 40, 0.45);
}

/* 图标：未选中 */
.ti-icon {
  width: 36rpx;
  height: 36rpx;
  background: #C4A882;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-size: contain;
}

/* 图标：选中态 — 白色，稍大 */
.ti-icon-act {
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
}

/* 标签 */
.ti-lbl {
  font-size: 20rpx;
  color: #C4A882;
}
.lbl-act {
  color: #C07048;
  font-weight: 600;
}

