<!-- 我的页面 -->
<view class="page">

  <!-- 顶部 banner -->
  <view class="banner">
    <view class="banner-icon">
      <view class="mic-icon"></view>
    </view>
    <text class="banner-title">今天忙啥了</text>
    <text class="banner-sub">录语音 · AI 整理 · 生成日报</text>
  </view>

  <!-- AI 状态 -->
  <view class="section-title">AI 配置</view>
  <view class="card">
    <view class="row">
      <text class="row-label">语音识别</text>
      <view class="row-right">
        <view class="badge {{asrProvider === 'mock' ? 'badge-mock' : 'badge-active'}}">
          <text>{{asrProvider === 'mock' ? '模拟模式' : '豆包 ASR'}}</text>
        </view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="row">
      <text class="row-label">AI 整理</text>
      <view class="row-right">
        <view class="badge {{aiProvider === 'mock' ? 'badge-mock' : 'badge-active'}}">
          <text>{{aiProvider === 'mock' ? '模拟模式' : 'DeepSeek'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 个人背景 -->
  <view class="section-title">个人背景</view>
  <view class="card context-card">
    <text class="context-hint">填写后 AI 会更准确地理解你的工作内容</text>
    <textarea
      class="context-input"
      placeholder="例如：我是一名销售经理，日常工作包括客户拜访、数据分析和团队管理"
      placeholder-class="context-placeholder"
      value="{{userContext}}"
      bindinput="onContextChange"
      maxlength="200"
      auto-height
    />
    <view class="context-footer">
      <text class="context-count">{{userContext.length}}/200</text>
      <view class="save-btn {{contextSaved ? 'save-btn-saved' : ''}}" bindtap="onSaveContext">
        <text>{{contextSaved ? '已保存 ✓' : '保存'}}</text>
      </view>
    </view>
  </view>

  <!-- 其他 -->
  <view class="section-title">其他</view>
  <view class="card">
    <view class="row tappable" bindtap="onClearCache">
      <text class="row-label">清除本地缓存</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="row tappable" bindtap="onFeedback">
      <text class="row-label">意见反馈</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="row tappable" bindtap="onAbout">
      <text class="row-label">关于</text>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <text class="version">v{{version}}</text>

  <!-- 意见反馈弹窗 -->
  <view class="modal-mask" wx:if="{{showFeedbackModal}}" bindtap="onFeedbackCancel">
    <view class="modal-box" catchtap="">
      <text class="modal-title">意见反馈</text>
      <textarea
        class="modal-input"
        placeholder="请输入你的意见或建议…"
        placeholder-class="modal-placeholder"
        value="{{feedbackText}}"
        bindinput="onFeedbackInput"
        maxlength="500"
        auto-height
        focus
      />
      <view class="modal-count">{{feedbackText.length}}/500</view>
      <view class="modal-actions">
        <view class="modal-btn modal-btn-cancel" bindtap="onFeedbackCancel">
          <text>取消</text>
        </view>
        <view class="modal-btn modal-btn-submit {{feedbackSubmitting ? 'btn-disabled' : ''}}" bindtap="onFeedbackSubmit">
          <text>{{feedbackSubmitting ? '提交中…' : '提交'}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
