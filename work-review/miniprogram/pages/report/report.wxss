/* 日报页 — healing 暖棕色调 */

.page-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(160deg, #FFF9F2 0%, #FEF5ED 45%, #FFF8F4 100%);
}

.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── 滚动区 ── */
.report-scroll {
  flex: 1;
  height: 0;
  padding: 32rpx 40rpx 0;
  box-sizing: border-box;
}

/* ── 加载中 ── */
.s-loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-ring {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #F0E8DE;
  border-top-color: #C07048;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C1E12;
  margin-bottom: 8rpx;
}

.loading-sub { font-size: 24rpx; color: #A0896E; }

/* ── 出错 ── */
.s-error {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 60rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #C04030;
  margin-bottom: 16rpx;
}

.error-msg {
  font-size: 26rpx;
  color: #A0896E;
  line-height: 1.65;
  margin-bottom: 48rpx;
  padding: 0 20rpx;
}

.retry-btn {
  padding: 20rpx 56rpx;
  border: 2rpx solid #E8D4BC;
  border-radius: 100rpx;
  font-size: 28rpx;
  color: #C07048;
  font-weight: 600;
}

/* ── 日期头 ── */
.report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.report-date {
  font-size: 36rpx;
  font-weight: 800;
  color: #2C1E12;
}

.regen-btn {
  font-size: 24rpx;
  color: #C07048;
  padding: 8rpx 24rpx;
  border: 2rpx solid #E8D4BC;
  border-radius: 100rpx;
}

/* ── Tab 切换 ── */
.tab-bar {
  display: flex;
  background: #F0E8DE;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.tab-item text {
  font-size: 28rpx;
  font-weight: 600;
  color: #A0896E;
}

.tab-item.active {
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(160, 100, 50, 0.12);
}

.tab-item.active text { color: #C07048; }

/* ── AI 标签 ── */
.ai-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #C07048;
  background: #FFF4EC;
  border: 1px solid rgba(192, 112, 72, 0.2);
  border-radius: 100rpx;
  padding: 4rpx 18rpx;
  margin-bottom: 24rpx;
}

/* ── 执行摘要 ── */
.summary-block {
  background: linear-gradient(135deg, #FFF9F4, #FEF5EC);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1px solid rgba(192, 112, 72, 0.12);
}

.summary-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #C07048;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #4A3322;
  line-height: 1.75;
  display: block;
}

.card-divider {
  height: 1px;
  background: #F0E8DE;
  margin: 0 0 24rpx;
}

/* ── 日报卡片 ── */
.report-card {
  background: #FFFFFF;
  border: 1px solid #F0E8DE;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(160, 100, 50, 0.06);
}

.report-text {
  font-size: 28rpx;
  line-height: 1.9;
  color: #2C1E12;
  white-space: pre-wrap;
  word-break: break-word;
  display: block;
}

.select-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #C4A882;
  margin-top: 20rpx;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  padding: 20rpx 40rpx 36rpx;
  background: linear-gradient(160deg, #FFF9F2, #FEF5ED);
  border-top: 1px solid #EEE4D8;
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-copy {
  flex: 1;
  height: 96rpx;
  border-radius: 200rpx;
  border: 3rpx solid #E8DDD0;
  background: #FFFFFF;
  color: #8B6E52;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-copy::after { border: none; }

.btn-save {
  flex: 1;
  height: 96rpx;
  border-radius: 200rpx;
  border: none;
  background: linear-gradient(135deg, #D4885E, #A85530);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(168, 85, 48, 0.3);
}
.btn-save::after { border: none; }

.btn-save.saved {
  background: linear-gradient(135deg, #7CB88A, #4A9060);
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 96, 0.3);
}

/* ── 顾问视角 ── */
.advisor-section {
  margin: 32rpx 0 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1px solid #F0E8DE;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(160, 100, 50, 0.06);
}

.advisor-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.advisor-icon { font-size: 32rpx; }

.advisor-section-title text:last-child {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C1E12;
}

.advisor-chips {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.advisor-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 100rpx;
  border: 2rpx solid #E8D4BC;
  background: #FDFAF7;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.advisor-chip text {
  font-size: 26rpx;
  color: #8B6E52;
  font-weight: 500;
}

.chip-active {
  background: linear-gradient(135deg, #D4885E, #A85530);
  border-color: transparent;
}

.chip-active text { color: #FFFFFF; }

.advice-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
}

.advice-spin {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #F0E8DE;
  border-top-color: #C07048;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  flex-shrink: 0;
}

.advice-loading text {
  font-size: 26rpx;
  color: #A0896E;
}

.advice-card {
  background: linear-gradient(135deg, #FFF4EC, #FEF0E4);
  border-radius: 20rpx;
  border: 1px solid rgba(192, 112, 72, 0.15);
  padding: 28rpx;
}

.advice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.advice-who {
  font-size: 24rpx;
  font-weight: 700;
  color: #C07048;
}

.advice-regen-btn {
  padding: 6rpx 20rpx;
  border: 1px solid rgba(192, 112, 72, 0.35);
  border-radius: 100rpx;
}

.advice-regen-btn text {
  font-size: 22rpx;
  color: #C07048;
}

.advice-text {
  font-size: 28rpx;
  color: #4A3322;
  line-height: 1.8;
}

.advice-error {
  font-size: 24rpx;
  color: #D85050;
  padding: 16rpx 0;
}
