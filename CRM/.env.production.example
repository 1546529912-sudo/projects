# === CRM 生产环境配置模板 ===
#
# 用法：
#   1. 复制本文件为 .env.production
#        cp .env.production.example .env.production
#   2. 把下面所有 "请改为..." 的值改成实际值
#   3. 用以下命令启动：
#        docker compose --env-file .env.production -f docker-compose.prod.yml up -d

# ---- 数据库 ----
POSTGRES_USER=crm
POSTGRES_PASSWORD=请改为强密码至少16位包含字母数字符号
POSTGRES_DB=crm

# ---- JWT 鉴权（必须改）----
# 生成命令：openssl rand -hex 32
JWT_SECRET=请生成32位以上随机字符串
JWT_EXPIRES_IN=8h

# ---- 密码加密 ----
PASSWORD_SALT_ROUNDS=10
LOGIN_MAX_FAILED=5

# ---- 前端 API 基址 ----
# 生产环境保持 /api/v1（同源，由 nginx 转发到 api 容器）
# 如果前后端分开部署在不同域名，改为绝对地址，例如：https://api.your-domain.com/api/v1
VITE_API_BASE_URL=/api/v1

# ---- Web 对外端口 ----
# 容器内固定 80，宿主机映射端口可改
# 推荐 8080，避免与宝塔自带 nginx 抢 80，运维可再用宝塔反向代理到此端口
WEB_PORT=8080
